<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press shortcuts on the launcher icon. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_queue"
        android:shortcutId="queue"
        android:shortcutLongLabel="@string/shortcut_queue_long"
        android:shortcutShortLabel="@string/shortcut_queue_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="streambuddy://queue"
            android:targetClass="com.streambuddy.app.MainActivity"
            android:targetPackage="com.streambuddy.app" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_settings"
        android:shortcutId="settings"
        android:shortcutLongLabel="@string/shortcut_settings_long"
        android:shortcutShortLabel="@string/shortcut_settings_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="streambuddy://settings"
            android:targetClass="com.streambuddy.app.MainActivity"
            android:targetPackage="com.streambuddy.app" />
    </shortcut>
</shortcuts>
