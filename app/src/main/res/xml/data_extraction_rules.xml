<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup/transfer rules for Android 12+. Same policy as backup_rules.xml: queue and learned
  weights are restored, cached media is not (it is excluded by not being listed).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="streambuddy.db" />
        <include domain="sharedpref" path="stream_buddy_settings.xml" />
        <include domain="sharedpref" path="stream_buddy_predictor.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="streambuddy.db" />
        <include domain="sharedpref" path="stream_buddy_settings.xml" />
        <include domain="sharedpref" path="stream_buddy_predictor.xml" />
    </device-transfer>
</data-extraction-rules>
