<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup/transfer rules for Android 12+. Same policy as backup_rules.xml: state is restored,
  cached media is not.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="streambuddy.db" />
        <include domain="sharedpref" path="stream_buddy_settings.xml" />
        <include domain="sharedpref" path="stream_buddy_predictor.xml" />
        <exclude domain="file" path="." />
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="streambuddy.db" />
        <include domain="sharedpref" path="stream_buddy_settings.xml" />
        <include domain="sharedpref" path="stream_buddy_predictor.xml" />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
